NODE_ENV=development
PORT=3000

# Local development: matches docker-compose.yml in the project root.
# Production: Railway injects DATABASE_URL from the Postgres service.
DATABASE_URL="postgresql://subtrack:subtrack@localhost:5440/subtrack?schema=public"

# Signs access tokens. Production: a long random string (openssl rand -base64 48).
JWT_SECRET=dev-only-secret-change-me-dev-only-secret

# Sign-in emails. Without a key (development only) the code is logged and shown in the app.
RESEND_API_KEY=
EMAIL_FROM="CardSweep <login@yourdomain.com>"

# AI reader for banks without a dedicated parser. Leave empty to accept SadaPay PDFs and CSV only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# RevenueCat sends this in the Authorization header of its webhooks.
REVENUECAT_WEBHOOK_SECRET=

# Lets test accounts switch to Pro without paying. Never true in production.
ALLOW_DEV_UPGRADE=true
